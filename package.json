{
	"name": "youloop",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.25.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test:share-url": "node --test tests/share-url.test.js",
		"test:hosting": "node --test tests/hosting-smoke.test.js",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:metadata": "node --test tests/video-metadata.test.js tests/youtube-thumbnail.test.js",
		"test:social": "node --test tests/social-smoke.test.js",
		"test:browser": "playwright test",
		"test:browser:timeline": "YOULOOP_TIMELINE_PROOF=1 playwright test editor-timeline.spec.ts",
		"test:browser:mock": "playwright test --grep @youtube-mock",
		"test:browser:routine": "pnpm test:browser",
		"test:clip": "node --test tests/video-gesture.test.js tests/clip-bounds.test.js tests/watch-playback-scope.test.js tests/editor-controls.test.js tests/youtube-orientation.test.js tests/watch-controls-placement.test.js",
		"knip": "svelte-kit sync && knip",
		"fallow": "node scripts/fallow.mjs",
		"fallow:full": "fallow --dupes-baseline fallow-baselines/dupes.json --health-baseline fallow-baselines/health.json --baseline-mode identity",
		"code-qc": "node scripts/code-qc.mjs",
		"fallow:raw": "fallow --summary",
		"knip:raw": "svelte-kit sync && knip",
		"test:browser:advisory": "YOULOOP_BROWSER_ADVISORY=1 playwright test"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@iconify-json/fluent": "^1.2.59",
		"@iconify-json/ic": "^1.2.4",
		"@leftium/nimble.css": "^0.24.1",
		"@playwright/test": "^1.64.0",
		"@sveltejs/adapter-vercel": "^7.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24.19.2",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"fallow": "3.33.1",
		"globals": "^17.13.0",
		"knip": "6.41.0",
		"mdsvex": "^0.12.8",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"sass-embedded": "^1.105.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.0",
		"typescript-eslint": "^8.71.1",
		"unplugin-icons": "^24.0.0",
		"vite": "^8.3.3"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@videojs/core": "10.1.0",
		"@videojs/html": "10.1.0",
		"@videojs/youtube-video": "10.1.0"
	}
}
